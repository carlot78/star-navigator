[ext_resource type="PackedScene" path="res://src/ui/settings_menu/settings_menu.tscn" id="7_settings"]

[node name="Campaign" type="Node2D"]
script = ExtResource("1_campaign")

[node name="StarSystem" parent="." instance=ExtResource("2_system")]

[node name="PlayerShip" parent="." instance=ExtResource("3_ship")]

[node name="Camera" type="Camera2D" parent="."]
script = ExtResource("4_camera")

[node name="Starfield" type="Node2D" parent="Camera"]
script = ExtResource("5_starfield")

[node name="HUD" type="CanvasLayer" parent="."]
process_mode = 3

[node name="SafeArea" type="MarginContainer" parent="HUD"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="TopBar" type="HBoxContainer" parent="HUD/SafeArea"]
layout_mode = 2
size_flags_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Menu" type="Button" parent="HUD/SafeArea/TopBar"]
custom_minimum_size = Vector2(120, 48)
layout_mode = 2
text = "Menu"

[node name="Status" type="Label" parent="HUD/SafeArea/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "Day 1  ·  0 cr"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Recenter" type="Button" parent="HUD/SafeArea/TopBar"]
custom_minimum_size = Vector2(120, 48)
layout_mode = 2
text = "Recenter"

[node name="PauseMenu" parent="HUD" instance=ExtResource("6_pause")]
visible = false

[node name="SettingsMenu" parent="HUD" instance=ExtResource("7_settings")]
visible = false
